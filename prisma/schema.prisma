generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auction {
  id          String    @id @default(cuid())
  title       String    @default("BrandMyLaptop.space Launch Auction")
  status      String    @default("ACTIVE") // ACTIVE, CLOSED, FINALIZED
  startTime   DateTime  @default(now())
  endTime     DateTime
  totalRaised Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  spots       Spot[]
}

model Spot {
  id               String       @id @default(cuid())
  auctionId        String
  auction          Auction      @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  number           Int          @unique // 1 to 10
  position         String       // "Top Left", "Top Center", etc.
  size             String       // "Large · 9.5 × 5.5 cm", etc.
  dimensions       String       // "9.5cm x 5.5cm"
  startingPrice    Float        @default(2500)
  currentBid       Float        @default(0)
  minBidIncrement  Float        @default(250)
  currentBidderName String?
  currentBidderEmail String?
  currentBrandName String?
  currentLogoUrl   String?
  currentWebsite   String?
  status           String       @default("AVAILABLE") // AVAILABLE, OCCUPIED, WON
  bidCount         Int          @default(0)
  clicksCount      Int          @default(0)
  stickerStatus    String       @default("PENDING") // PENDING, WINNER_CONFIRMED, LOGO_RECEIVED, PREPARED, INSTALLED, PROOF_UPLOADED
  proofImageUrl    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  bids             Bid[]
  winners          Winner[]
  installations    StickerInstallation[]
}

model Bid {
  id            String    @id @default(cuid())
  spotId        String
  spot          Spot      @relation(fields: [spotId], references: [id], onDelete: Cascade)
  bidderName    String
  bidderEmail   String
  brandName     String
  website       String?
  logoUrl       String?
  amount        Float
  status        String    @default("PENDING") // PENDING, CONFIRMED, OUTBID, WON, CANCELLED
  dodoSessionId String?   @unique
  dodoPaymentId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payment       Payment?
  winner        Winner?
}

model Payment {
  id            String    @id @default(cuid())
  bidId         String    @unique
  bid           Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  dodoSessionId String?
  dodoPaymentId String?
  status        String    @default("PENDING") // PENDING, SUCCEEDED, FAILED, CANCELLED
  amount        Float
  currency      String    @default("INR")
  metadata      String?   // JSON string of Dodo metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Winner {
  id            String    @id @default(cuid())
  spotId        String    @unique
  spot          Spot      @relation(fields: [spotId], references: [id], onDelete: Cascade)
  bidId         String    @unique
  bid           Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  brandName     String
  bidderName    String
  bidderEmail   String
  website       String?
  logoUrl       String?
  winningAmount Float
  status        String    @default("CONFIRMED") // CONFIRMED, PAID
  stickerStatus String    @default("WINNER_CONFIRMED") // WINNER_CONFIRMED, LOGO_RECEIVED, PREPARED, INSTALLED, PROOF_UPLOADED
  proofImageUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StickerInstallation {
  id            String    @id @default(cuid())
  spotId        String
  spot          Spot      @relation(fields: [spotId], references: [id], onDelete: Cascade)
  brandName     String
  stickerStatus String    @default("WINNER_CONFIRMED") // WINNER_CONFIRMED, LOGO_RECEIVED, PREPARED, INSTALLED, PROOF_UPLOADED
  proofImageUrl String?
  notes         String?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

model AdminConfig {
  id           String   @id @default("default_config")
  outbidPolicy String   @default("V1_MANUAL_REVIEW") // Policy: explain V1 non-refundable ad placement or credit
  siteActive   Boolean  @default(true)
  pageViews    Int      @default(1)
  updatedAt    DateTime @updatedAt
}
